  id: "energy-swap"
  title:
    english: "A swap spends one shared price"
    vietnamese: "Đổi chỗ trả một khoản chung"
  summary:
    english: "Swap a hand card with an opposing seated card and reach zero."
    vietnamese: "Đổi bài trên tay với bài đối phương trên bàn rồi nhìn tim về 0."
  cards:
    - {fileID: 11400000, guid: 1c18a4e5c09576a4c8bf591a9ee69c21, type: 2}
    - {fileID: 11400000, guid: bef221d6ce75b574a90bbd11c69e79c1, type: 2}
