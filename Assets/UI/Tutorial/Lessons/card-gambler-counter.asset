  m_Name: "card-gambler-counter"
  m_EditorClassIdentifier: ""
  id: "card-gambler-counter"
  title:
    english: "Gambler · answering a hidden bet"
    vietnamese: "Gambler · đối đáp một lần cược"
  summary:
    english: "Both players bet; observe the first loss and second win separately."
    vietnamese: "Cả hai cùng cược; xem riêng người trước thua và người sau thắng."
  cards:
    - {fileID: 11400000, guid: 1c18a4e5c09576a4c8bf591a9ee69c21, type: 2}
    - {fileID: 11400000, guid: bef221d6ce75b574a90bbd11c69e79c1, type: 2}
    - {fileID: 11400000, guid: 0e5e4d9274768c145afabdebbc985ef0, type: 2}
    - {fileID: 11400000, guid: a0b6f4c9608f0ec469215f15867c8f8a, type: 2}
    - {fileID: 11400000, guid: bec87eaf388d0b245a621b499aa5b904, type: 2}
    - {fileID: 11400000, guid: de0908fde32179f44a77aea719b20b31, type: 2}
    - {fileID: 11400000, guid: 4ac2d2882d9f7704b860cb6773eb8ebe, type: 2}
