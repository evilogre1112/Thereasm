    - action: 15
      source: 0
      target: 0
      seat: -1
      prepare: []
      title:
        english: "Follow the consequence"
        vietnamese: "Nhìn lại kết quả"
      instruction:
        english: "Open Cemetery."
        vietnamese: "Bấm Nghĩa trang."
      purpose:
        english: "The shot removed a real card. Dead cards cannot sit or vote until a resurrection brings them back."
        vietnamese: "Phát bắn đã loại một lá thật. Bài chết không được ngồi hay bỏ phiếu, trừ khi có kỹ năng hồi sinh."
      success:
