      prepare: []
      title:
        english: "A steady hand"
        vietnamese: "Giữ tay thật vững"
      instruction:
        english: "Press Let's continue when you are ready."
        vietnamese: "Bấm Mình thử tiếp nhé khi bạn đã sẵn sàng."
      purpose:
        english: "Hunter is already seated. Five hearts buy one shot; the ability refreshes after Sacrifice, not at every new action turn."
        vietnamese: "Hunter đã ngồi sẵn. Một phát bắn dùng đủ 5 tim; kỹ năng hồi sau khi xong hiến tế, không phải cứ sang lượt mới là được bắn lại."
      success:
        english: "That is it. Keep that little clue with you."
        vietnamese: "Đúng rồi. Giữ lấy gợi ý nhỏ này nhé."
      choiceA:
        english: ""
        vietnamese: ""
      choiceB:
        english: ""
        vietnamese: ""
      answer: 0
