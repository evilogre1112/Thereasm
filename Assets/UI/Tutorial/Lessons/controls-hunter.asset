      seat: -1
      prepare: []
      title:
        english: "Your next small discovery"
        vietnamese: "Thêm một điều để khám phá"
      instruction:
        english: "Close Cemetery with the same button."
        vietnamese: "Bấm lại Nghĩa trang để đóng."
      purpose:
        english: "Reading the cemetery costs no hearts. Return to the table when you have seen the result."
        vietnamese: "Xem nghĩa trang không tốn tim. Khi đã thấy kết quả, mình trở về bàn nhé."
      success:
        english: "That is it. Keep that little clue with you."
        vietnamese: "Đúng rồi. Giữ lấy gợi ý nhỏ này nhé."
