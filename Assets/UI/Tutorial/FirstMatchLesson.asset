  - {fileID: 11400000, guid: 0e5e4d9274768c145afabdebbc985ef0, type: 2}
  - {fileID: 11400000, guid: a0b6f4c9608f0ec469215f15867c8f8a, type: 2}
  - {fileID: 11400000, guid: bec87eaf388d0b245a621b499aa5b904, type: 2}
  - {fileID: 11400000, guid: de0908fde32179f44a77aea719b20b31, type: 2}
  - {fileID: 11400000, guid: 4ac2d2882d9f7704b860cb6773eb8ebe, type: 2}
  practiceScene: MainBoard
  menuScene: MenuScenes
  inspectDescription: "Villager · SỐ 10\n\nĐây là một lá thường, không có kỹ năng chủ động.\n\nĐặt từ nhóm của phe đang chơi: 2 tim. Nhóm đối phương hoặc trung lập: 5 tim.\n\nChuột phải lần nữa để đóng."
  heartOverview: "GIỮ SỨC CHO MỘT ĐÊM DÀI\n\nNhững trái tim trên góc màn hình là sức để bạn hành động. Mỗi phe có phần của mình, tối đa 5 tim; đây không phải máu của lá bài.\n\nMỗi lần đặt bài, chuyển ghế, thay/đổi bài hoặc dùng một số kỹ năng, bạn sẽ tiêu tim. Giá dựa vào nhóm gốc của lá, không dựa vào vai trò bí mật nó đang giấu.\n\nKhi lượt hành động của bạn bắt đầu, tim được hồi đủ 5 tim. Phần dư không cộng dồn. Đến pha Hiến tế, bạn dùng số tim còn lại; riêng bỏ phiếu không tốn tim.\n\nĐừng lo phải nhớ hết ngay. Ta sẽ thử từng nước, để bạn tự thấy lúc nào tim mất đi và lúc nào được lấy lại."
  movementCosts: "CHO MỘT LÁ BƯỚC LÊN BÀN\nMột chỗ ngồi cho bài thuộc phe bạn tốn 2 tim. Nếu đưa bài đối phương hoặc trung lập từ tay xuống ghế trống, bạn cần trả 5 tim.\n\nĐƯA LÁ ĐÃ NGỒI SANG GHẾ KHÁC\nKhi hết khóa, chuyển bài mình hoặc trung lập sang ghế trống tốn 1 tim. Muốn chuyển bài đối phương, bạn cần 3 tim.\n\nĐÓN LÁ BÀI TRỞ VỀ TAY\nTự rút bài mình hoặc trung lập được hoàn tối đa 2 tim, không vượt số tim đã trả khi đặt. Bạn cũng không thể giữ hơn 5 tim.\nÉp bài đối phương về tay thì bạn trả 5 tim; không ai được hoàn tim.\n\nCòn nhớ lá số 12 không? Bạn đã tiêu 1 tim để chuyển ghế, rồi lấy lại 2 tim khi rút về. Đôi khi lùi một bước là để chuẩn bị cho bước tiếp theo."
  swapCosts: "KHI HAI LÁ TRÊN BÀN ĐỔI CHỖ\nCó lúc chỉ đổi vị trí đã đủ mở ra một nước mới. Nếu cả hai là bài mình hoặc trung lập, bạn trả 2 tim cho cả lần đổi.\nCó đúng một lá đối phương thì lần đổi tốn 3 tim. Nếu cả hai đều là bài đối phương, bạn cần trả 5 tim.\n\nKHI BẠN MUỐN ĐƯA MỘT LÁ MỚI VÀO\nKéo bài từ tay lên ghế đã có bài: lá cũ về tay chủ sở hữu gốc, lá mới ngồi thay. Cặp bài chỉ gồm bài mình hoặc trung lập thì tốn 3 tim. Có bất kỳ lá đối phương nào trong cặp thì tốn 5 tim. Lá bị thay không được hoàn tim riêng.\n\nBạn vừa dùng lá số 12 thay lá số 3 bằng 5 tim, nhớ chứ? Cũng lưu ý: không thể đổi ngược cùng một cặp liên tục trong lượt, và lá đang khóa vẫn phải chờ."
  skillCosts: "CÓ NHỮNG THỜI KHẮC ĐÁNG ĐỂ GIỮ TIM\nHunter bắn hoặc Witch dùng phép đều cần 5 tim. Nếu đang chờ ra đòn, đừng vội tiêu hết vào di chuyển. Gambler và Invoker hiện không tốn tim khi dùng kỹ năng, nhưng vẫn cần đúng mục tiêu và thời điểm.\n\nMỖI LÁ CŨNG CÓ CÁCH RIÊNG\nTotem còn kỹ năng: đặt hoặc chuyển ghế tốn 1 tim; tự rút được hoàn 1 tim. Ép Totem đối phương về tay cũng tốn 1 tim.\nĐưa Prankster từ tay lên bàn tốn 3 tim, dù nó thuộc nhóm nào.\n\nHẾT TIM, BẠN VẪN CÒN VIỆC ĐỂ LÀM\nXem bài, đổi tab, ghi sổ, xem nghĩa trang, chọn vai trò, nguyền rủa, bỏ phiếu và kết thúc lượt đều không tốn tim. Thanh trừng cũng miễn phí, nhưng mỗi phe chỉ có 2 lần dùng mỗi ván. Thiếu tim thì thao tác bị từ chối, không trừ thêm."
