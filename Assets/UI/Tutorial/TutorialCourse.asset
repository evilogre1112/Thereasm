    - id: "energy"
      title:
        english: "Spend your hearts wisely"
        vietnamese: "Dùng tim đúng lúc"
      summary:
        english: "Energy, zero-heart refusals, refills, movement and swaps."
        vietnamese: "Năng lượng, hết tim, hồi tim, dời bài và đổi chỗ."
      icon: {fileID: 21300000, guid: 4efef92bc2c24b7d93fbe1509a07762a, type: 3}
      lessons:
        - {fileID: 11400000, guid: ee3d2dd674724a178d407561f46f4a11, type: 2}
    - id: "cards"
      title:
        english: "One ability at a time"
        vietnamese: "Mỗi lá một bí quyết"
      summary:
        english: "One lesson per card. Compare both sides and try healthy and Decay effects together."
        vietnamese: "Mỗi lá một bài. Thử cả hai phía, đối chiếu kỹ năng khỏe và Decay ngay trên cùng bàn."
      icon: {fileID: 21300000, guid: 18f371cac2d54d7d9b57f62b4ed862f5, type: 3}
