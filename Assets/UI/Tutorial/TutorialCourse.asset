  chapters:
    - id: "controls"
      title:
        english: "Hands on the cards"
        vietnamese: "Làm chủ thao tác"
      summary:
        english: "Read, place, retrieve, aim Hunter, vote, sacrifice and Purge."
        vietnamese: "Xem, đặt, rút bài, nhắm Hunter, bỏ phiếu, hiến tế và thanh trừng."
