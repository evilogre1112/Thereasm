--- !u!114 &7000000000000000396
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7000000000000000188}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cd3e0896d7947949b610c878e35a234, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  label: {fileID: 7000000000000000191}
  tmpLabel: {fileID: 0}
  originalTextMaterial: {fileID: 0}
  sourceText: "\u0110\u1EA5u m\xE1y \xB7 C\u1EA5p 1 \xB7 1 Cursermancer\nOnline lu\xF4n
    c\xF3 2 Cursermancer; c\u1EA5p \u0111\u1ED9 ch\u1EC9 \xE1p d\u1EE5ng khi \u0111\u1EA5u
    m\xE1y."
--- !u!114 &7000000000000000397
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7000000000000000192}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cd3e0896d7947949b610c878e35a234, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  label: {fileID: 7000000000000000195}
  tmpLabel: {fileID: 0}
  originalTextMaterial: {fileID: 0}
  sourceText: "CHU\u1ED8T TR\xC1I  Ch\u1ECDn / k\xE9o b\xE0i     \xB7     CHU\u1ED8T
    PH\u1EA2I  Xem m\xF4 t\u1EA3     \xB7     ESC  Lu\u1EADt ch\u01A1i"
--- !u!114 &7000000000000000398
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
