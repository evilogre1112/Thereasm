  originalTextMaterial: {fileID: 0}
  sourceText: "Cu\u1ED9n \u0111\u1EC3 xem \u0111\u1EA7y \u0111\u1EE7 \xB7 Tr\u1EADn
    \u0111\u1EA5u \u0111ang t\u1EA1m d\u1EEBng"
--- !u!114 &7000000000000000375
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7000000000000000220}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cd3e0896d7947949b610c878e35a234, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  label: {fileID: 7000000000000000223}
  tmpLabel: {fileID: 0}
  originalTextMaterial: {fileID: 0}
  sourceText: "M\u1EE4C TI\xCAU\nD\xE2n l\xE0ng th\u1EAFng khi ti\xEAu di\u1EC7t
    to\xE0n b\u1ED9 Cursermancer. Cursermancer th\u1EAFng khi s\u1ED1 Cursermancer
    c\xF2n s\u1ED1ng b\u1EB1ng ho\u1EB7c nhi\u1EC1u h\u01A1n s\u1ED1 b\xE0i D\xE2n
    l\xE0ng c\xF2n s\u1ED1ng. Cursermancer trung l\u1EADp v\u1EABn \u0111\u01B0\u1EE3c
    t\xEDnh.\n\n1. H\xC0NH \u0110\u1ED8NG\nHai phe lu\xE2n phi\xEAn, m\u1ED7i l\u01B0\u1EE3t
    c\xF3 5 tim. \u0110\u1EB7t b\xE0i m\xECnh: 2 tim; b\xE0i \u0111\u1ED1i ph\u01B0\u01A1ng
    ho\u1EB7c trung l\u1EADp: 5 tim. Totem v\xE0 c\xE1c k\u1EF9 n\u0103ng c\xF3 chi
    ph\xED ri\xEAng.\n\n2. NGUY\u1EC0N R\u1EE6A\nKhi b\xE0n \u0111\u1EA7y ho\u1EB7c
    Tr\u01B0\u1EDFng l\xE0ng g\u1ECDi, Cursermancer ch\u1ECDn m\u1EE5c ti\xEAu c\xF9ng
    h\xE0ng/c\u1ED9t. Gh\u1EBF tr\u1ED1ng ch\u1EB7n l\xE2y nhi\u1EC5m.\n\n3. HI\u1EBEN
    T\u1EBE\nM\u1ED7i l\xE1 c\u1EE7a phe \u0111ang b\u1ECF phi\u1EBFu ch\u1ECDn m\u1ED9t
    l\xE1 kh\xE1c tr\xEAn b\xE0n. Kh\xF4ng t\u1EF1 b\u1ECF phi\u1EBFu. L\xE1 duy
    nh\u1EA5t tr\xEAn b\xE0n \u0111\u01B0\u1EE3c mi\u1EC5n. Nhi\u1EC1u phi\u1EBFu
    nh\u1EA5t b\u1ECB hi\u1EBFn t\u1EBF; h\xF2a phi\u1EBFu th\xEC t\u1EA5t c\u1EA3
    l\xE1 \u0111\u1ED3ng h\u1EA1ng b\u1ECB hi\u1EBFn t\u1EBF. K\u1EF9 n\u0103ng c\xF3
    th\u1EC3 \u0111\u1ED5i k\u1EBFt qu\u1EA3.\n\nTHANH TR\u1EEANG\nM\u1ED7i phe c\xF3
    2 l\u1EA7n trong c\u1EA3 v\xE1n, lo\u1EA1i b\xE0i nhi\u1EC5m \u1EDF tay v\xE0
    b\xE0n. Ch\u1EC9 d\xF9ng trong l\u01B0\u1EE3t h\xE0nh \u0111\u1ED9ng.\n\nR\xDAT
    B\xC0I\nR\xFAt b\xE0i m\xECnh ho\u1EB7c trung l\u1EADp ho\xE0n t\u1ED1i \u0111a
    2 tim, kh\xF4ng v\u01B0\u1EE3t chi ph\xED \u0111\u1EB7t. Totem ch\u1EC9 ho\xE0n
    1 tim.\n\n\u0110I\u1EC0U KHI\u1EC2N\nChu\u1ED9t tr\xE1i \u0111\u1EC3 ch\u1ECDn
    ho\u1EB7c k\xE9o b\xE0i. Chu\u1ED9t ph\u1EA3i \u0111\u1EC3 xem m\xF4 t\u1EA3.
    C\xE1c k\u1EF9 n\u0103ng \u0111\u1EB7c bi\u1EC7t v\xE0 chi ph\xED n\u1EB1m trong
    m\xF4 t\u1EA3 t\u1EEBng l\xE1. ESC \u0111\xF3ng b\u1EA3ng lu\u1EADt v\xE0 ti\u1EBFp
    t\u1EE5c tr\u1EADn."
